[worldserver]

########################################
# ClassLootFilter (mod-class-loot-filter)
########################################
#
#    ClassLootFilter.Enable
#        Description: Active ou désactive le module.
#        Default:     1

ClassLootFilter.Enable = 1

#    ClassLootFilter.ExcludeBots
#        Description: Ignore les personnages contrôlés par mod-playerbots
#                      (bots d'équipe ou bots aléatoires) : leur loot n'est
#                      jamais retiré/remplacé/compensé, seuls les vrais
#                      joueurs sont filtrés.
#                      Nécessite mod-playerbots présent dans l'arbre.
#        Default:     1

ClassLootFilter.ExcludeBots = 1

#    ClassLootFilter.OnlyBindOnEquip
#        Description: Ne filtrer que les objets "Lié quand équipé" (BoE).
#                      Laisser à 1 pour ne pas toucher aux BoP (déjà gérés
#                      par le système de loot standard / need-before-greed).
#        Default:     1

ClassLootFilter.OnlyBindOnEquip = 1

#    ClassLootFilter.FilterArmor
#        Description: Filtrer les armures (tissu/cuir/mailles/plaques,
#                      boucliers, reliques) selon la classe du joueur.
#        Default:     1

ClassLootFilter.FilterArmor = 1

#    ClassLootFilter.StrictArmorPreference
#        Description: Mode strict : chaque classe n'accepte qu'UN SEUL type
#                      d'armure "préféré" (avec repli auto si le skill n'est
#                      pas encore acquis) au lieu de tout ce qu'elle peut
#                      légalement porter.
#                      Ex: Mage -> tissu uniquement.
#                          Guerrier/Paladin -> plaques si skill, sinon mailles.
#                          Chasseur/Chaman -> mailles si skill, sinon cuir.
#                          Voleur/Druide -> cuir uniquement.
#                      Si désactivé (0), retombe sur l'ancien comportement
#                      permissif (tout ce que la classe peut porter est
#                      accepté, ex: un guerrier garde aussi le cuir/tissu).
#        Default:     1

ClassLootFilter.StrictArmorPreference = 1

#    ClassLootFilter.FilterWeapons
#        Description: Filtrer les armes selon la proficience de classe.
#                      Table approximative (règles classiques WotLK) :
#                      à valider avant activation.
#        Default:     0

ClassLootFilter.FilterWeapons = 1

#    ClassLootFilter.MinItemLevel
#        Description: Niveau d'objet minimum à partir duquel le filtre
#                      s'applique (évite de toucher au loot trivial/gris).
#        Default:     1

ClassLootFilter.MinItemLevel = 1

#    ClassLootFilter.TryAlternateItem
#        Description: Si activé, avant de compenser en or, le module tente
#                      de donner à la place un autre objet du MÊME butin qui
#                      est utilisable par la classe du joueur.
#        Default:     1

ClassLootFilter.TryAlternateItem = 1

#    ClassLootFilter.GoldCompensationPct
#        Description: Pourcentage du prix de vente vendeur donné en or quand
#                      aucune pièce utile n'a été trouvée (fallback final).
#        Default:     100

ClassLootFilter.GoldCompensationPct = 100

#    ClassLootFilter.Announce
#        Description: Annoncer en chat au joueur qu'un objet a été
#                      remplacé/compensé.
#        Default:     1

ClassLootFilter.Announce = 1
