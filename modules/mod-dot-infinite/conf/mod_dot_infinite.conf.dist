[worldserver]

########################################
# mod-dot-infinite
#
# Deux familles de DoT, deux comportements :
#
#  - DoT À DISTANCE (magie, malédictions, maladies, Moonfire, Serpent Sting...)
#    Ils se propagent d'eux-mêmes à toute cible en combat contre le joueur ou son groupe.
#
#  - DoT de MÊLÉE (saignements de toutes les classes, poisons du voleur)
#    Ils ne se propagent pas. À chaque coup, ils sont appliqués à tout le pack
#    d'ennemis engagés qui est au corps à corps.
#
# La famille est déterminée automatiquement par le sort (pas par la classe) :
# saignement ou poison du voleur => mêlée, tout le reste => à distance.
########################################

#
#    DotInfinite.Enable
#        Description: Active le module.
#        Default:     1
#

DotInfinite.Enable = 1

#
#    DotInfinite.Duration
#        Description: Durée (en secondes) de tous les DoT lancés par le joueur.
#                     0 = permanent (jusqu'au dispel, à la mort de la cible ou à un reset).
#                     La durée n'est jamais plus courte que la durée naturelle du sort.
#        Default:     120
#

DotInfinite.Duration = 120

########################################
# DoT À DISTANCE : propagation automatique
########################################

#
#    DotInfinite.Ranged.Enable
#        Description: Propage les DoT à distance à toute créature en combat contre le joueur
#                     ou son groupe : à la pose, à chaque tick, et à chaque ennemi qui
#                     rejoint le combat.
#        Default:     1
#

DotInfinite.Ranged.Enable = 8

#
#    DotInfinite.Ranged.Range
#        Description: Distance maximale (en yards) entre une créature qui porte le DoT
#                     et une autre créature en combat pour la propagation.
#                     0 = pas de limite.
#        Default:     60
#

DotInfinite.Ranged.Range = 60

########################################
# DoT de MÊLÉE : application au pack à chaque coup
########################################

#
#    DotInfinite.Melee.Enable
#        Description: À chaque coup du joueur, applique ses DoT de mêlée à toutes les
#                     créatures en combat qui sont au corps à corps (celles qui les ont déjà
#                     voient leur durée remise au maximum).
#        Default:     1
#

DotInfinite.Melee.Enable = 1

#
#    DotInfinite.Melee.Range
#        Description: Distance (en yards) ajoutée à la portée de mêlée du joueur au moment
#                     du coup pour considérer une créature "au corps à corps".
#                     0 = portée de mêlée stricte.
#        Default:     2
#

DotInfinite.Melee.Range = 2

#
#    DotInfinite.Melee.Interval
#        Description: Délai minimum (en millisecondes) entre deux évaluations pour un même
#                     joueur. Évite de recalculer à chaque cible d'un coup de zone.
#                     0 = à chaque coup.
#        Default:     250
#

DotInfinite.Melee.Interval = 250

########################################
# Options avancées
########################################

#
#    DotInfinite.AffectPlayers
#        Description: Applique aussi l'allongement de durée quand la cible est un joueur (PvP).
#                     Déconseillé. Il n'y a jamais de propagation vers ou depuis des joueurs.
#        Default:     0
#

DotInfinite.AffectPlayers = 0

#
#    DotInfinite.IncludePets
#        Description: Inclut les DoT lancés par les pets / gardiens du joueur.
#        Default:     0
#

DotInfinite.IncludePets = 0

#
#    DotInfinite.ExcludedSpells
#        Description: (optionnel) Sorts exclus du module (ID séparés par des virgules).
#                     Décommenter pour l'utiliser.
#        Default:     aucun
#

DotInfinite.ExcludedSpells = ""
